# 1. Base Image - Choose a Node.js version suitable for your project
FROM node:18-alpine AS builder

# 2. Set working directory
WORKDIR /usr/src/app

# 3. Copy package.json and package-lock.json (or yarn.lock)
# Assuming package-lock.json is used, adjust if it's yarn.lock
COPY package*.json ./

# 4. Install all dependencies (including devDependencies for the build step)
RUN npm install

# 5. Copy the rest of your application source code
# This respects .dockerignore
COPY . .

# Generate Prisma Client before building
RUN npx prisma generate

# 6. Run the build script (compile TypeScript from src to dist)
# 'tsc' is available via npx from typescript devDependency
# Output will be in './dist' mirroring 'src' structure, e.g., src/index.ts -> dist/index.js
RUN npx tsc --outDir ./dist --rootDir ./src

# --- Production Stage ---
FROM node:18-alpine

WORKDIR /usr/src/app

# Copy package.json and package-lock.json for production dependencies
COPY package*.json ./

# Copy node_modules (including production dependencies and generated Prisma client) from builder
COPY --from=builder /usr/src/app/node_modules ./node_modules

# Copy built artifacts from the builder stage
COPY --from=builder /usr/src/app/dist ./dist

# Copy Prisma schema from builder (needed if generate is run at startup, also good for consistency)
COPY --from=builder /usr/src/app/prisma ./prisma

# Copy the start script
COPY start.sh .
# Make it executable
RUN chmod +x ./start.sh

# Expose the port your application runs on (default 4000 from src/index.ts if PORT env var not set)
# This will be used by docker-compose to map to a host port
EXPOSE ${BACKEND_INTERNAL_PORT:-4000}

# Define the command to run your application using the start script
CMD ["./start.sh"]
