# Use an official Node.js LTS image with Alpine for smaller size
FROM node:18-alpine AS builder

# Set the working directory in the container
WORKDIR /app

# Copy package.json and package-lock.json to leverage Docker cache
# This layer only rebuilds if package files change
COPY package*.json ./

# Install production dependencies. Using npm ci is faster and more reliable
RUN npm ci

# Copy the rest of your application source code
COPY . .

# Build the TypeScript application
# This assumes your package.json has a "build": "tsc" script
RUN npx prisma generate
RUN npm run build

# --- Production Stage ---
FROM node:18-alpine

WORKDIR /app

# Copy only the necessary files from the builder stage
# This includes package.json (for start script), package-lock.json (if using),
# node_modules (production only), and the built application code
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/prisma ./prisma

# Copy the startup script
COPY start.sh ./

# Make the startup script executable
RUN chmod +x start.sh

# Expose the port your app listens on (defaulting to 4000 based on your code)
# This should match your process.env.PORT in your application
EXPOSE 4000

# Set the default command to run your startup script
CMD [ "./start.sh" ]

# Note: You will need to provide environment variables (like DATABASE_URL, JWT_SECRET, PORT)
# when running the container (e.g., using docker run -p <host_port>:4000 -e <VAR>=<VALUE> or Docker Compose)